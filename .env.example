# Copy to .env and fill in. .env is git-ignored; no script prints these values.
# Builds, tests, script/e2e_register.sh, script/measure_offchain.sh, script/measure.sh, and
# script/measure_groth16.sh need none of them and no network.

# Ethereum mainnet JSON-RPC endpoint (including any API key).
# script/l1_price.sh: base fees (eth_feeHistory) and the Chainlink ETH/USD reading.
# script/circuits_setup.sh: optional beacon for phase 2 (or set PPREV_BEACON instead).
ETH_MAINNET_RPC_URL=

# Base mainnet JSON-RPC endpoint. script/measure_l2.sh: L2 gas price and L1 fee parameters of one block.
BASE_MAINNET_RPC_URL=

# Base Sepolia JSON-RPC endpoint. script/measure_l2.sh: the campaign's transactions.
BASE_SEPOLIA_RPC_URL=

# Private key of a Base Sepolia test wallet (never a key that holds real funds).
# script/measure_l2.sh deploys and sends from it and stops if its balance is too low.
TESTNET_PRIVATE_KEY=
